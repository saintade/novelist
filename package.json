{
  "name": "novelist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "@xmldom/xmldom": "^0.8.15"
  },
  "scripts": {
    "dev": "vite",
    "start": "node --experimental-strip-types server/index.ts",
    "build": "tsc -b && vite build",
    "build:extension": "tsc --project extension/tsconfig.json && node scripts/build-extension.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:integration": "RUN_SUPABASE_TESTS=1 vitest run src/lib/library/repository.integration.test.ts",
    "test:browser": "playwright test",
    "test:extension": "npm run build:extension && playwright test --config playwright.extension.config.ts",
    "benchmark:downloads": "npm run build:extension && node scripts/benchmark-downloads.mjs",
    "migration:manifest": "node --experimental-strip-types scripts/library-manifest.ts",
    "scraper:setup": "docker build --tag novelist-scraper:1 server/scraper/sandbox",
    "scraper:experiment": "node --experimental-strip-types server/scraper/cli.ts",
    "test:scraper": "RUN_SCRAPER_TESTS=1 vitest run server/scraper",
    "format": "prettier --write src server extension scripts tests playwright.config.ts playwright.extension.config.ts vite.config.ts index.html package.json",
    "db:start": "supabase start -x realtime,imgproxy,inbucket,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:lint": "supabase db lint --local",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@fontsource/literata": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@streamparser/json": "0.0.26",
    "@supabase/supabase-js": "^2.116.0",
    "cheerio": "1.2.0",
    "diff": "9.0.0",
    "dompurify": "^3.4.15",
    "epubjs": "^0.3.93",
    "express": "5.2.1",
    "fast-fuzzy": "1.12.0",
    "gpt-tokenizer": "4.0.0",
    "helmet": "8.3.0",
    "html-to-text": "^10.0.1",
    "ipaddr.js": "2.5.0",
    "lucide-react": "^1.43.0",
    "openai": "^7.13.0",
    "pg": "8.23.0",
    "pluralize": "8.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "4.0.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "0.2.9",
    "@types/express": "5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@types/pluralize": "0.0.33",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "supabase": "^2.117.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
